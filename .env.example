# Password for the owner dashboard at /owner
OWNER_PASSWORD=change-me
# SQLite for local dev. For production use e.g. postgresql+psycopg2://user:pass@host:5432/delivery
DATABASE_URL=sqlite:///./delivery.db
# Long random string used to sign the owner session cookie
SECRET_KEY=replace-with-a-long-random-string
# Public URL of this server, used in tracking and staff links
BASE_URL=http://localhost:8000
# OSRM routing server for road routes. The public demo server is rate-limited;
# use your own OSRM for production. Leave empty to draw straight lines instead.
ROUTING_URL=https://router.project-osrm.org
